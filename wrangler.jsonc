{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "eastmoney-dashboard",
  "main": "worker/entry.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "AI_GATEWAY_ID": "default",
    "DATA_API_BASE_URL": "https://eastmoney.hasbai.xyz/data"
  },
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare"
  },
  "placement": {
    "mode": "smart"
  },
  "routes": [
    {
      "pattern": "eastmoney.hasbai.xyz/*",
      "zone_name": "hasbai.xyz"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "eastmoney",
      "database_id": "b80cfbe1-1226-46cc-a22b-3ebbaefe85bf",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BOND_LEDGER",
      "bucket_name": "bond-ledger",
      "remote": true
    },
    {
      "binding": "FUND_REPORTS",
      "bucket_name": "bond-ledger",
      "remote": true
    }
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "26b76413a03a4328836d95f3ca320a1e"
    }
  ],
  "workflows": [
    {
      "binding": "BOND_LEDGER_IMPORT",
      "name": "bond-ledger-import",
      "class_name": "BondLedgerImportWorkflow"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    }
  }
}
