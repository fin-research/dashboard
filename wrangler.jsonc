{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "eastmoney-dashboard",
  "main": "worker/entry.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "AUTH0_DOMAIN": "hasbai.eu.auth0.com",
    "AUTH0_LOGIN_DOMAIN": "auth.hasbai.xyz",
    "AUTH0_CLIENT_ID": "16vMxoYpr5AdPRiW1PkwIiHuRWszii6m",
    "AUTH0_MANAGEMENT_CLIENT_ID": "MriIYaKO6xE8QfOAMdiQMxmKeSq53eHo",
    "ACCESS_MODE": "enforce",
    "ACCESS_TEAM_DOMAIN": "hasbai.cloudflareaccess.com",
    "ACCESS_AUD": "3eceddd7e32af3ce30d8209174e4ad8238fd9a27b700f1337fcff689a13fa973",
    "CLOUDFLARE_ACCOUNT_ID": "5cecc63c78acf8f5473f8745f4244448",
    "AI_GATEWAY_ID": "default",
    "DATA_API_BASE_URL": "https://eastmoney.hasbai.xyz/data",
    "AUTH_PROVIDER": "auth0-access",
    "AUTH0_ROLE_IDS": "{\"admin\":\"rol_eoDAJuWbdjwEzEln\",\"handler\":\"rol_dUEQWoUpRu5kzcqi\",\"reviewer\":\"rol_8WnIILDtpeyWuu3O\"}",
    "CHOICE_DATA_API_URL": "https://eastmoney.hasbai.xyz/data",
    "FINANCING_AUTH0_MANAGEMENT_CLIENT_ID": "LA46CcB3FQ4Uac4JyEzPSObcV4PV8CFU"
  },
  "secrets": {
    "required": [
      "CF_AIG_TOKEN",
      "AUTH0_MANAGEMENT_CLIENT_SECRET",
      "FINANCING_AUTH0_MANAGEMENT_CLIENT_SECRET"
    ]
  },
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare"
  },
  "placement": {
    "mode": "smart"
  },
  "triggers": {
    "crons": [
      "0 16 * * *",
      "0 * * * *"
    ]
  },
  "routes": [
    {
      "pattern": "eastmoney.hasbai.xyz/*",
      "zone_name": "hasbai.xyz"
    }
  ],
  "services": [
    {
      "binding": "DATA",
      "service": "eastmoney-data",
      "entrypoint": "InternalData",
      "remote": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "eastmoney",
      "database_id": "b80cfbe1-1226-46cc-a22b-3ebbaefe85bf",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "CREDIT",
      "bucket_name": "credit",
      "remote": true
    },
    {
      "binding": "EASTMONEY",
      "bucket_name": "eastmoney",
      "remote": true
    },
    {
      "binding": "LIABILITY_REPORT_SNAPSHOTS",
      "bucket_name": "eastmoney",
      "remote": true
    }
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "26b76413a03a4328836d95f3ca320a1e"
    }
  ],
  "workflows": [
    {
      "binding": "BOND_LEDGER_IMPORT",
      "name": "bond-ledger-import",
      "class_name": "BondLedgerImportWorkflow"
    },
    {
      "binding": "ECONOMIC_INDICATOR_SYNC",
      "name": "economic-indicator-sync",
      "class_name": "EconomicIndicatorSyncWorkflow"
    },
    {
      "binding": "DEBT_IMPORT_WORKFLOW",
      "name": "financing-debt-import",
      "class_name": "DebtImportWorkflow"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    }
  },
  "ai_search": [
    {
      "binding": "CREDIT_SEARCH",
      "instance_name": "credit",
      "remote": true
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CREDIT_AGENT",
        "class_name": "CreditAgent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "credit-agent-v1",
      "new_sqlite_classes": [
        "CreditAgent"
      ]
    }
  ]
}
