{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "eastmoney-dashboard",
  "main": "worker/entry.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "CLOUDFLARE_ACCOUNT_ID": "5cecc63c78acf8f5473f8745f4244448",
    "AI_GATEWAY_ID": "default",
    "DATA_API_BASE_URL": "https://eastmoney.hasbai.xyz/data"
  },
  "secrets": {
    "required": ["CF_AIG_TOKEN"]
  },
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare"
  },
  "placement": {
    "mode": "smart"
  },
  "routes": [
    {
      "pattern": "eastmoney.hasbai.xyz/*",
      "zone_name": "hasbai.xyz"
    }
  ],
  "services": [
    {
      "binding": "DATA",
      "service": "eastmoney-data",
      "remote": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "eastmoney",
      "database_id": "b80cfbe1-1226-46cc-a22b-3ebbaefe85bf",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "EASTMONEY",
      "bucket_name": "eastmoney",
      "remote": true
    }
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "26b76413a03a4328836d95f3ca320a1e"
    }
  ],
  "workflows": [
    {
      "binding": "BOND_LEDGER_IMPORT",
      "name": "bond-ledger-import",
      "class_name": "BondLedgerImportWorkflow"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    }
  }
}
