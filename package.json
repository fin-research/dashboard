{
  "name": "dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 8765",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 8765",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.worker.json",
    "worker:dev": "pnpm build && wrangler dev",
    "worker:deploy": "pnpm build && wrangler deploy",
    "worker:typegen": "wrangler types --include-runtime false"
  },
  "dependencies": {
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/kit": "^2.70.2",
    "d3-cloud": "^1.2.9",
    "echarts": "^6.0.0",
    "html-to-image": "^1.11.13",
    "svelte": "5.56.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260813.1",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@tailwindcss/vite": "4.3.3",
    "@types/d3-cloud": "^1.2.9",
    "@types/node": "^24.0.0",
    "daisyui": "5.7.4",
    "svelte-check": "^4.7.4",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "wrangler": "4.122.0"
  }
}
