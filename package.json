{
  "name": "dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local ./node_modules/vite/bin/vite.js --mode dev --host 127.0.0.1 --port 8765",
    "build": "pnpm typecheck && pnpm worker:typecheck && vite build",
    "preview": "pnpm build && wrangler dev",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "worker:dev": "pnpm build && wrangler dev",
    "worker:deploy": "pnpm build && wrangler deploy",
    "worker:typegen": "node scripts/generate-worker-types.mjs",
    "worker:typecheck": "tsc --project tsconfig.worker.json",
    "bond:db:migrate": "node scripts/apply-bond-migrations.mjs",
    "bond:db:backfill": "node scripts/backfill-bond-ledgers.mjs",
    "financing-model:db:migrate": "node scripts/apply-financing-model-migrations.mjs",
    "db:sync:remote": "node scripts/sync-remote-d1.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "prepare": "svelte-kit sync"
  },
  "dependencies": {
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/kit": "^2.70.2",
    "d3-cloud": "^1.2.9",
    "echarts": "^6.0.0",
    "html-to-image": "^1.11.13",
    "pg": "^8.23.0",
    "svelte": "5.56.8",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260823.1",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@tailwindcss/vite": "4.3.3",
    "@types/d3-cloud": "^1.2.9",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "daisyui": "5.7.4",
    "svelte-check": "^4.7.4",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "wrangler": "4.125.0"
  }
}
